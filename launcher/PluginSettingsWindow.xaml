<Window x:Class="Applepie.Launcher.PluginSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="插件基础配置" Width="790" Height="650" MinWidth="680" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" Padding="12,10" HorizontalContentAlignment="Stretch" Focusable="False">
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="▾" Margin="12,0,0,0" /><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" /></DockPanel>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="280"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Option" Background="{DynamicResource Panel}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource NavigationSelected}" /></Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource Selection}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock x:Name="PluginTitle" Style="{StaticResource SectionTitle}" />
      <TextBlock x:Name="Notice" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1"><StackPanel x:Name="FieldsPanel" /></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <TextBlock x:Name="Status" Text="修改后自动保存" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
      <TextBlock x:Name="ConfigPath" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="DiscardButton" Content="放弃未保存的修改" Click="Discard" Visibility="Collapsed" Margin="0,0,10,0" />
        <Button Content="关闭" Click="CloseClick" Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
