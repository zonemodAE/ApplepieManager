<Window x:Class="Applepie.Launcher.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="安装 Applepie Manager" Width="720" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="Assets/Logo.png" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="38" Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <DockPanel Margin="0,0,0,22">
        <Image Source="Assets/Logo.png" Width="48" Height="48" DockPanel.Dock="Left" Margin="0,0,18,0" />
        <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource ThemeToggleButton}" Click="ToggleTheme" VerticalAlignment="Center" Margin="18,0,0,0" />
        <TextBlock Text="APPLEPIE SETUP" FontFamily="Bahnschrift" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AccentText}" />
      </DockPanel>
      <TextBlock Text="不来一块苹果派吗？" Style="{StaticResource SectionTitle}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,28,0,0">
      <TextBlock Text="安装位置" Margin="0,0,0,10" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Destination" />
        <Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="Browse" />
      </Grid>
      <CheckBox x:Name="DesktopShortcut" Content="创建桌面快捷方式" IsChecked="True" Margin="0,18,0,0" />
      <TextBlock Text="默认安装到当前用户目录。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,18,0,0" />
      <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" Margin="0,22,0,0" Foreground="{DynamicResource Muted}" />
      <ProgressBar x:Name="SetupProgress" Visibility="Collapsed" Margin="0,12,0,0" />
    </StackPanel>
    <Button Grid.Row="2" x:Name="Install" Content="安装 Applepie Manager  ↗" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="InstallClick" Padding="25,13" />
  </Grid>
</Window>
